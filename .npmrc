# Dependency install scripts never run: none of them are needed to lint, build or test
# this package (they belong to n8n CLI internals, e.g. isolated-vm, which does not
# compile on Node 26). npm 12 blocks them by default; this makes npm 11 do the same.
# It also skips pre/post lifecycle scripts (e.g. prepublishOnly); this package has none.
ignore-scripts=true
